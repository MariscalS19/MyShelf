# Copia este archivo como .env y pon tus datos reales (el .env NO se sube a Git)

# Cadena de conexión a PostgreSQL
# Formato: postgresql+psycopg2://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql+psycopg2://postgres:tu_password@localhost:5432/myshelf

# Orígenes que pueden llamar a la API (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Días de anticipación para avisar que algo va a caducar
DIAS_ALERTA_CADUCIDAD=7
